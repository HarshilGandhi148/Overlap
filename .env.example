TYPESENSE_HOST=127.0.0.1
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=replace-with-your-local-key
TYPESENSE_COLLECTION_PREFIX=overlap_local
OMDB_API_KEY=
